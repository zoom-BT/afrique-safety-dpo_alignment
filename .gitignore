# Python
__pycache__/
*.py[cod]
.venv/
env/
*.egg-info/

# Secrets
.env
kaggle.json

# Experiment tracking
wandb/

# Sorties recuperees depuis Kaggle: regenerables par `kaggle_run.py fetch`, et lourdes.
# Le motif results/**/checkpoint-* ne suffisait pas -- TRL ecrit aussi un dossier "final",
# et 41 Mo d'adaptateurs et d'optimiseur sont passes dans un commit avant qu'on le voie.
results/kaggle/

# Model artifacts (large binaries, never checked in)
results/**/checkpoint-*
results/**/dpo_checkpoints/
*.safetensors
*.bin
*.gguf

# Dataset cache (regenerable, see config.yaml paths.cache_dir)
.cache/

# Notebook noise
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Kaggle batch staging (regenerable, one directory per pushed notebook)
.kaggle_staging/

# Adaptateurs LoRA rapatries de Kaggle: 42 Mo chacun, binaires, reproduits par les runs.
# Ils transitent vers Kaggle par un dataset prive, pas par git.
adapters/
